# 本机开发直接 npm start；自部署时复制为 .env 并设置真实域名和公网 IP。
PUBLIC_ORIGIN=https://send.example.com
PORT=8787
HOST=127.0.0.1
MAX_FILE_MB=50
PAIR_GLOBAL_LIMIT=100

# TURN_SECRET 必须替换为至少 32 字符的随机值，并保持 app 与 coturn 一致。
# 生成方式：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TURN_SECRET=
TURN_EXTERNAL_IP=
TURN_REALM=send.example.com
TURN_URLS=turn:send.example.com:3478?transport=udp,turn:send.example.com:3478?transport=tcp
STUN_URLS=stun:send.example.com:3478
# 仅验收中继时设为 1，通常保持 0。
FORCE_RELAY=0
