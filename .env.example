# 本地直接 npm run build && npm start。自部署复制为 .env 并填写实际 HTTPS origin。
PUBLIC_ORIGIN=http://localhost:8787
HOST=127.0.0.1
PORT=8787
MAX_FILE_MB=50
PAIR_GLOBAL_LIMIT=100
DEFAULT_LOCALE=en
CLI_DOWNLOAD_URL=
INDEXNOW_KEY=
# Optional first-party analytics. Off by default; never contacts the author's servers.
ANALYTICS_ENABLED=0
ANALYTICS_PATH=/api/analytics

# WebSocket 连接配额与业务限流，完整说明见 CONTRIBUTING.md。
WS_MAX_CONNECTIONS=1000
WS_MAX_CONNECTIONS_PER_IP=64
WS_MAX_CONNECTIONS_PER_DEVICE=8
WS_MAX_PENDING_CONNECTIONS=128
WS_MAX_PENDING_PER_IP=8
WS_MAX_GUEST_CONNECTIONS=256
WS_GUEST_IDLE_SECONDS=60
WS_PUBLISH_INTERVAL_MS=50
WS_MAX_BUFFERED_KB=1024
WS_MESSAGE_RATE_PER_MINUTE=3000
WS_MESSAGE_BURST=256
WS_RENAME_RATE_PER_MINUTE=10
WS_RENAME_BURST=3
WS_RENAME_IP_RATE_PER_MINUTE=60
WS_RENAME_IP_BURST=12
WS_TRANSFER_RATE_PER_MINUTE=600
WS_TRANSFER_BURST=16
WS_TRANSFER_IP_RATE_PER_MINUTE=1800
WS_TRANSFER_IP_BURST=48

# 逗号分隔，空值不使用任何公共备用服务器。
STUN_URLS=
TURN_URLS=
# shared-secret（兼容旧配置）或 static；两种认证字段不能混用。
TURN_AUTH_MODE=shared-secret
TURN_SECRET=
TURN_USERNAME=
TURN_PASSWORD=
TURN_CREDENTIAL_TTL_SECONDS=3600
FORCE_RELAY=0

# 仅 docker compose -f compose.yaml -f compose.turn.yaml 使用本地 coturn 时填写。
# TURN_SECRET 至少 32 字符；app 与 coturn 必须相同。
TURN_EXTERNAL_IP=
TURN_REALM=
