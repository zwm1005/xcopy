# 本地直接 npm run build && npm start。自部署复制为 .env 并填写实际 HTTPS origin。
PUBLIC_ORIGIN=http://localhost:8787
HOST=127.0.0.1
PORT=8787
MAX_FILE_MB=50
PAIR_GLOBAL_LIMIT=100
DEFAULT_LOCALE=en
CLI_DOWNLOAD_URL=
INDEXNOW_KEY=

# 逗号分隔，空值不使用任何公共备用服务器。
STUN_URLS=
TURN_URLS=
# shared-secret（兼容旧配置）或 static；两种认证字段不能混用。
TURN_AUTH_MODE=shared-secret
TURN_SECRET=
TURN_USERNAME=
TURN_PASSWORD=
TURN_CREDENTIAL_TTL_SECONDS=3600
FORCE_RELAY=0

# 仅 docker compose -f compose.yaml -f compose.turn.yaml 使用本地 coturn 时填写。
# TURN_SECRET 至少 32 字符；app 与 coturn 必须相同。
TURN_EXTERNAL_IP=
TURN_REALM=
