# Optional: copy outside Git, configure the upstream and a random secret,
# then include this file INSIDE the website's HTTPS server block.
# Do not include it when ANALYTICS_ENABLED=0.
# Bind the Java port to a private interface / restrict it to this proxy.
# If using a CDN, configure real_ip only for the CDN's verified CIDRs first.

location = /api/analytics/bootstrap {
    if ($request_method != GET) {
        return 405;
    }
    proxy_pass http://127.0.0.1:8892/analytics/bootstrap;
    include /etc/nginx/snippets/xcopy-analytics-private.conf;
}

location = /api/analytics/events {
    if ($request_method != POST) {
        return 405;
    }
    proxy_pass http://127.0.0.1:8892/analytics/collect;
    include /etc/nginx/snippets/xcopy-analytics-private.conf;
}
