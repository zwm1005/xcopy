PUBLIC_ORIGIN=https://send.example.com
HOST=127.0.0.1
PORT=18787
DB_PATH=/var/lib/suichuan/suichuan.sqlite
TRUST_PROXY=1
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
MAX_FILE_MB=50
PAIR_GLOBAL_LIMIT=100
TURN_URLS=turn:relay.example.com:3480?transport=udp,turn:relay.example.com:3480?transport=tcp
# 使用部署者自己的 STUN / TURN。
STUN_URLS=stun:stun.example.com:3478
TURN_SECRET=REPLACE_ON_SERVER
FORCE_RELAY=0
DEFAULT_LOCALE=en
CLI_DOWNLOAD_URL=
INDEXNOW_KEY=
ANALYTICS_ENABLED=0
ANALYTICS_PATH=/api/analytics
TURN_AUTH_MODE=shared-secret
TURN_USERNAME=
TURN_PASSWORD=
TURN_CREDENTIAL_TTL_SECONDS=900

# 清理默认关闭；备份数据库并观察容量后按需设为 1。
DEVICE_CLEANUP_ENABLED=0
DEVICES_MAX_RECORDS=100000
DEVICE_UNPAIRED_RETENTION_DAYS=30
